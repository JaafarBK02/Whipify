# Required for AI diagnoses. Without it the API still runs and returns generic clarifying questions.
OPENAI_API_KEY=

# Optional: model used for the diagnose-or-clarify step
OPENAI_MODEL=gpt-4o-mini

# Optional: log sessions, messages, detected cues and diagnoses to Supabase (see backend/schema.sql).
# Use the service role key: it stays on the server and is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: SQLite file for beta users and access tokens (created automatically)
BETA_DB_PATH=whipify.db

# Optional: deployed frontend origins allowed by CORS, comma-separated (localhost is always allowed)
ALLOWED_ORIGINS=
